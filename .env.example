# APP_URL / NEXT_PUBLIC_BASE_URL: Public URL of your SearchBiz instance
APP_URL="https://searchbiz.co.za"
NEXT_PUBLIC_BASE_URL="https://searchbiz.co.za"

# Signing secrets for HttpOnly session cookies & email OTPs (set strong random values on VPS)
SESSION_SECRET="replace_with_a_long_random_session_secret"
OTP_SECRET="replace_with_a_long_random_otp_secret"
ADMIN_EMAIL="admin@searchbiz.co.za"

# Nodemailer SMTP Configuration (Mox Mail Server on VPS - SPF/DKIM/DMARC/MTA-STS managed by Mox)
# Inside Docker, email-service automatically tries host.docker.internal, 172.17.0.1, and mail.searchbiz.co.za on ports 465 & 587.
# Gmail SMTP is disabled; all mail routes exclusively through Mox.
SMTP_HOST="mail.searchbiz.co.za"
SMTP_PORT="465"
SMTP_USER="admin@searchbiz.co.za"
SMTP_PASS="your_mox_mailbox_password"
FROM_EMAIL="admin@searchbiz.co.za"

# Role-based Mox Mailboxes (optional per-mailbox passwords; falls back to SMTP_PASS if omitted)
NOREPLY_EMAIL="noreply@searchbiz.co.za"
SMTP_NOREPLY_USER="noreply@searchbiz.co.za"
SMTP_NOREPLY_PASS="your_mox_noreply_password"

AI_EMAIL="ai@searchbiz.co.za"
SMTP_AI_USER="ai@searchbiz.co.za"
SMTP_AI_PASS="your_mox_ai_password"

ADMIN_MAILBOX="admin@searchbiz.co.za"
SMTP_ADMIN_USER="admin@searchbiz.co.za"
SMTP_ADMIN_PASS="your_mox_admin_password"

HELP_EMAIL="help@searchbiz.co.za"
SMTP_HELP_USER="help@searchbiz.co.za"
SMTP_HELP_PASS="your_mox_help_password"

# Gemini API Key for dynamic local business SEO generation
GEMINI_API_KEY=

# Master administrator directory cleanup & bulk purge authorization password
NEXT_PUBLIC_ADMIN_DELETE_PASSWORD="Delete6604211989!?"

# Llama3 VPS API Configurations for AI Browser Agent
LLAMA3_API_URL="http://localhost:11434"
LLAMA3_API_KEY=""

# Telegram Bot Token for Hermes Autonomous Agent (@Searchbiz_bot)
TELEGRAM_BOT_TOKEN=""

# SearchBiz Bot API Secret for external VPS agents
SEARCHBIZ_BOT_SECRET="searchbiz_agent_key_2026"

# Mox IMAP Inbound Email Configuration (Port 993 SSL/TLS)
IMAP_HOST="mail.searchbiz.co.za"
IMAP_PORT="993"
IMAP_USER="admin@searchbiz.co.za"
IMAP_PASS=""

# Mox Webmail & Admin Portal URLs
# Webmail: https://mail.searchbiz.co.za/webmail/
# Admin:   https://mail.searchbiz.co.za/admin/

# PostgreSQL Database Connection String (matches docker-compose.yml db service)
DATABASE_URL="postgresql://sb_admin_secure_usr:Sb9_kL82_vX97_mQ41_zP30_rN@db:5432/searchbiz_db"
